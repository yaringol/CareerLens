HEADLESS=true
OUTPUT_PATH=../data/raw/jobs_raw.jsonl
SITE=example
START_URL=https://example.com
MAX_JOBS=50

# LinkedIn raw ingest (scraping/external/linkedin.py)
# Copy to scraping/.env, or set JOBS_MONGO_URI in backend/.env (linkedin reads that too).
MONGO_URI=mongodb://root:CHANGE_ME@your-mongo-host:27017/jobs?authSource=admin
