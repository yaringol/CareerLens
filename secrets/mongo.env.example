# Copy to secrets/mongo.env (gitignored) and fill in the real credential.
# Used only by ofelia's job-run (see ofelia/config.ini) — mounted read-only into the
# pipeline container at /run/secrets/mongo.env, sourced by pipeline/run_daily.sh.
MONGO_URI=mongodb://root:CHANGE_ME@mongodb:27017/jobs?authSource=admin
