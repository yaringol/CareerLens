# Python
__pycache__/
*.pyc
.venv/
.venv311/
.env

# Secrets (see *.example counterparts - placeholders only, no real credentials)
secrets/mongo.env

# DB migration - URIs are session env vars only; these patterns catch accidents.
# Dump archives live outside the repo (C:\tmp\careerlens-migration) by design.
scripts/db-migration/*.local.ps1
scripts/db-migration/*.env
*.gz

# Data outputs
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# OS / IDE
.DS_Store
~$*
.vscode/
.idea/
.cursor/
github-helper.sh

# Build artifacts
*node_modules*
frontend/dist/
backend/dist/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Playwright MCP - generated session logs/snapshots/screenshots
.playwright-mcp/
qa-*.png

# DS model - the production artifacts are tracked (via LFS) so a clone can run the
# server; the dated training snapshots are local backups only
ds/model/*_20*.joblib
ds/model/NEW.ipynb
ds/model/logs/
ds/model/token_dist.json
ds/model/tsne_map.html
ds/model/.ipynb_checkpoints/
ds/model/skill_db_relax_*.json
ds/model/model.joblib.bak-*
# working copy the retrain notebook writes for its before/after diff
ds/model/model.joblib.baseline

# Internal working docs - historical plans, task boards and QA scratch, local only
/LOGIN_QA_REPORT.md
/QA_TEST_PLAN.md
backend/TASKS.md
backend/docs/
docs/TASKS.md
docs/JIRA_TASKS.md
docs/JIRA_TASKS_DS.md
